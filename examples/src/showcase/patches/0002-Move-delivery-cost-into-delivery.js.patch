diff --git a/src/delivery.js b/src/delivery.js
new file mode 100644
index 0000000..95b668b
--- /dev/null
+++ b/src/delivery.js
@@ -0,0 +1,7 @@
+import { config } from './config.js';
+
+export function deliveryCost(order) {
+  const kg = Math.ceil(order.weightKg);
+  const cost = config.deliveryBase + kg * config.deliveryPerKg;
+  return Math.min(cost, config.maxDelivery);
+}
