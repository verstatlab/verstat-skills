{
  "title": "noise",
  "description": "explain-pr: changes that need no reading: imports, wiring, formatting, generated files. Collapsed rows. Data is `auto`: paste the `noise` items of `verstat facts diff`. Not rendered when `items` is empty.",
  "type": "object",
  "required": [
    "id",
    "type",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "noise"
    },
    "title": {
      "type": "string",
      "description": "Heading of the block (h2)."
    },
    "subtitle": {
      "type": "string",
      "description": "One line under the heading."
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "paths",
          "lines",
          "body"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Part id, unique in the block; a route step can focus it."
          },
          "kind": {
            "enum": [
              "imports",
              "whitespace",
              "generated",
              "wiring",
              "other"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "lines": {
            "type": "integer",
            "minimum": 1,
            "description": "How many changed lines (+ and −) the item covers."
          },
          "body": {
            "type": "string",
            "description": "The lines, under a header line per path."
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
