      }
    ],
    "subset": "uvx --from 'fonttools[woff]' pyftsubset package/files/archivo-latin-800-normal.woff2 --unicodes='U+0020,U+002D-002E,U+0030-0039,U+0041-005A,U+005F,U+0061-007A' --flavor=woff2 --no-hinting --desubroutinize --layout-features=kern --output-file=archivo/Archivo-ExtraBold.subset.woff2",
    "faces": [
      {
        "file": "archivo/Archivo-ExtraBold.subset.woff2",
        "family": "Archivo",
        "weight": 800,
        "style": "normal"
      }
    ],
    "license": "archivo/LICENSE"
  }
