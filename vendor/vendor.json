  "plex": {
    "kind": "font",
    "label": "IBM Plex Sans 2.0.0, IBM Plex Mono 2.5.0 (subset)",
    "sources": [
      {
        "package": "@ibm/plex-sans",
        "version": "2.0.0",
        "source": "https://registry.npmjs.org/@ibm/plex-sans/-/plex-sans-2.0.0.tgz",
        "integrity": "sha512-iGvuyYd1nBw5ojlspC+uMKvQNd1rlbPR4LX9bzn6KsnXULPemANYmHyZPlrDGDBWaJb84crU/A4rNoH5dl3/Wg=="
      },
      {
        "package": "@ibm/plex-mono",
        "version": "2.5.0",
        "source": "https://registry.npmjs.org/@ibm/plex-mono/-/plex-mono-2.5.0.tgz",
        "integrity": "sha512-STBJIPxPomOYPmBMO7z5TKPJUotAF9u3gAUumTqVgwgrAO+K4FRNh0MlhsoJjKhJKsMbBJR10/bk4inkj/wc1w=="
      }
    ],
    "subset": "uvx --from 'fonttools[woff]' pyftsubset package/fonts/complete/woff2/<face>.woff2 --unicodes='U+0020-007E,U+00A0-00FF,U+0400-045F,U+0490-0491,U+2010-2027,U+2030-203A,U+2116,U+2190-2193,U+2212' --flavor=woff2 --no-hinting --desubroutinize --layout-features=kern,liga --output-file=plex/<face>.subset.woff2",
    "faces": [
      {
        "file": "plex/IBMPlexSans-Regular.subset.woff2",
        "family": "IBM Plex Sans",
        "weight": 400,
        "style": "normal"
      },
      {
        "file": "plex/IBMPlexSans-SemiBold.subset.woff2",
        "family": "IBM Plex Sans",
        "weight": 600,
        "style": "normal"
      },
      {
        "file": "plex/IBMPlexMono-Regular.subset.woff2",
        "family": "IBM Plex Mono",
        "weight": 400,
        "style": "normal"
      }
    ],
    "license": "plex/LICENSE.txt"
  },
  "archivo": {
    "kind": "font",
    "label": "Archivo 5.3.0 ExtraBold (subset, logo only)",
    "sources": [
      {
        "package": "@fontsource/archivo",
        "version": "5.3.0",
        "source": "https://registry.npmjs.org/@fontsource/archivo/-/archivo-5.3.0.tgz",
