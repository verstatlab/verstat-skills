    {
      "id": "answer",
      "type": "brief",
      "answer": "An order is paid through a charge at the gateway, after which it becomes paid and publishes order.paid; refundDecision decides a refund by status, days after delivery and amount."
    },
    {
      "id": "states",
      "type": "state-machine",
      "title": "Order states",
      "subtitle": "Transitions from the TRANSITIONS table and the checks in move().",
      "states": [
        {
          "id": "draft",
          "label": "Draft",
          "initial": true,
          "anchor": {
            "repo": "checkout",
            "path": "src/orders/states.js",
            "find": "['draft', 'submit', 'pending'],"
          }
        },
        {
          "id": "pending",
          "label": "Awaiting payment"
        },
        {
          "id": "paid",
          "label": "Paid"
        },
        {
          "id": "shipped",
          "label": "Shipped"
        },
        {
          "id": "delivered",
          "label": "Delivered"
        },
        {
          "id": "refunded",
          "label": "Refunded",
          "final": true
        },
        {
          "id": "cancelled",
          "label": "Cancelled",
          "final": true
        },
        {
          "id": "disputed",
          "label": "Dispute",
          "text": "There is no transition out of a dispute."
        },
        {
