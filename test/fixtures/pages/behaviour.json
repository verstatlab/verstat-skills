    {
      "id": "refund-rules",
      "type": "decision-table",
      "title": "Can the money be refunded",
      "subtitle": "refundDecision: the first condition that matches decides.",
      "outcomeLabel": "Decision",
      "conditions": [
        {
          "id": "status",
          "label": "Status"
        },
        {
          "id": "days",
          "label": "Days after delivery"
        },
        {
          "id": "total",
          "label": "Amount"
        },
        {
          "id": "vip",
          "label": "VIP"
        }
      ],
      "rows": [
        {
          "id": "r-ship",
          "when": {
            "status": "shipped",
            "days": "*",
            "total": "*",
            "vip": "*"
          },
          "outcome": "carrier-recall",
          "literal": "order.status === 'shipped'",
          "anchor": {
            "repo": "checkout",
            "path": "src/refunds/policy.js",
            "find": "if (order.status === 'shipped') return 'carrier-recall';"
          },
          "source": "code"
        },
        {
          "id": "r-auto",
          "when": {
            "status": "delivered",
            "days": "≤ 14",
            "total": "< 5000",
            "vip": "*"
          },
          "outcome": "auto",
          "literal": "days <= 14 && order.total < 5000",
          "anchor": {
            "repo": "checkout",
            "path": "src/refunds/policy.js",
            "find": "if (days <= 14 && order.total < 5000) return 'auto';"
          },
          "source": "code"
        },
        {
          "id": "r-manual",
          "when": {
            "status": "delivered",
            "days": "≤ 14",
            "total": "≥ 5000",
            "vip": "*"
          },
          "outcome": "manual",
          "literal": "order.total >= 5000",
          "anchor": {
            "repo": "checkout",
            "path": "src/refunds/policy.js",
            "find": "if (days <= 14 && order.total >= 5000) return 'manual';"
          },
          "source": "code"
        },
        {
          "id": "r-vip",
          "when": {
            "status": "delivered",
            "days": "> 14",
            "total": "*",
            "vip": "yes"
          },
          "outcome": "manual",
          "literal": "days > 14 && order.vip",
          "anchor": {
            "repo": "checkout",
            "path": "src/refunds/policy.js",
            "find": "if (days > 14 && order.vip) return 'manual';"
          },
          "source": "code"
        },
        {
          "id": "r-reject",
          "when": {
            "status": "delivered",
            "days": "> 14",
            "total": "*",
            "vip": "*"
          },
          "outcome": "reject",
          "literal": "days > 30",
          "anchor": {
            "repo": "checkout",
            "path": "src/refunds/policy.js",
            "find": "if (days > 14) return 'reject';"
          },
          "source": "code",
          "note": "The order in the code saves VIPs: their row comes first."
        },
        {
          "id": "r-cancelled",
          "when": {
            "status": "cancelled",
            "total": "*",
            "vip": "*"
          },
          "literal": "return undefined",
          "anchor": {
            "repo": "checkout",
            "path": "src/refunds/policy.js",
            "find": "return undefined;"
          },
          "source": "code",
          "note": "The code does not consider cancelled orders."
        }
      ]
    },
