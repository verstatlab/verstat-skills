        {
          "id": "ep-pay",
          "method": "POST",
          "path": "/invoices/:id/pay",
          "between": "checkout → billing → gateway",
          "text": "Charges the invoice amount; a retry with the same idempotency key returns the first payment.",
          "headers": [
            {
              "name": "Idempotency-Key",
              "value": "<uuid>",
              "note": "required"
            }
          ],
          "response": "200 { \"id\": 3, \"invoice_id\": 7, \"amount_cents\": 300, \"status\": \"succeeded\" }",
          "failures": [
            {
              "code": "400",
              "text": "no Idempotency-Key"
            },
            {
              "code": "404",
              "text": "no such invoice"
            },
            {
              "code": "409",
              "text": "the invoice is already paid"
            },
            {
              "code": "502",
              "text": "the gateway declined CHARGE_RETRIES times"
            }
          ],
          "anchor": {
            "repo": "billing",
            "path": "src/http/routes.js",
            "find": "app.post('/invoices/:id/pay',"
          },
          "source": "code"
