    {
      "id": "risks",
      "type": "risks",
      "title": "Risks",
      "risks": [
        {
          "id": "rk-tx",
          "severity": "high",
          "title": "A payment without an updated invoice",
          "consequence": "The money is charged but the invoice is open: the client sees “not paid” and pays again with a new key.",
          "reference": "failure modes · the process dies between the write and the update",
          "anchor": {
            "repo": "billing",
            "path": "src/payments.js",
            "find": "await db.update('invoices', { id: invoice.id }, { status: 'paid' });"
          },
          "source": "inferred"
        },
        {
          "id": "rk-stale",
          "severity": "medium",
          "title": "Stale cache after a manual edit",
          "consequence": "An invoice edit in the database that bypasses the code shows only after INVOICE_CACHE_TTL.",
          "reference": "config panel · INVOICE_CACHE_TTL",
          "anchor": {
            "repo": "billing",
            "path": "src/cache.js",
            "find": "ttl: config.invoiceCacheTtl"
          }
        },
        {
          "id": "rk-currency",
          "severity": "high",
          "title": "Changing the currency on the fly",
          "consequence": "New invoices are in another currency, while the gateway charges total_cents without conversion.",
          "reference": "README · Currency"
        },
        {
          "id": "rk-rounding",
          "severity": "low",
          "title": "Tax rounding",
          "consequence": "Tax is rounded on every line, not on the total: up to a cent of difference per line.",
          "reference": "README · Tax"
        },
        {
          "id": "rk-retry",
          "severity": "medium",
          "title": "A retry without an idempotency key",
          "consequence": "A manual retry from the admin creates a new key and may charge twice.",
          "reference": "failure modes · the gateway does not respond"
        },
        {
          "id": "rk-ttl-zero",
          "severity": "low",
          "title": "INVOICE_CACHE_TTL = 0",
          "consequence": "The cache is off: every request goes to the database and latency grows under load.",
          "reference": "config panel · INVOICE_CACHE_TTL"
        },
        {
          "id": "rk-webhook",
          "severity": "medium",
          "title": "Unsigned gateway webhook",
          "consequence": "A forged webhook can mark an invoice as paid.",
          "reference": "README · Webhooks"
        }
      ]
    },
