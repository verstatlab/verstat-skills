          "visible": "409 { \"error\": \"invoice already paid\" }",
          "anchor": {
            "repo": "billing",
            "path": "src/payments.js",
            "find": "throw new PaymentError(409, 'invoice already paid')"
          }
        },
        {
          "id": "fm-crash",
          "situation": "The process dies between writing the payment and updating the invoice",
