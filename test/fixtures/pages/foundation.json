  "blocks": [
    {
      "id": "answer",
      "type": "brief",
      "answer": "An order becomes paid when a charge returns a payment whose amount equals the order total; the gateway is tried three times, and if all retries fail, capture throws the last error and the order stays in pending.",
      "facts": [
        {
          "id": "f-amount",
          "text": "markPaid refuses if the payment amount does not match the order total.",
          "anchor": {
            "repo": "shop",
            "path": "src/orders/order.js",
            "find": "if (payment.amount !== order.total) throw new Error('amount mismatch');"
          },
          "source": "code"
        },
        {
          "id": "f-retries",
          "text": "A charge makes up to three attempts and does not wait between them.",
          "anchor": {
            "repo": "shop",
            "path": "src/payments/capture.js",
            "find": "for (let attempt = 1; attempt <= RETRIES; attempt++) {",
            "findEnd": "  }\n  throw lastError;"
          },
          "source": "code"
        },
        {
          "id": "f-test",
          "text": "The test checks that after one timeout the order is still paid.",
          "anchor": {
            "repo": "shop",
            "path": "test/capture.test.js",
            "find": "assert.equal(order.status, 'paid');"
          },
          "source": "test"
        },
        {
          "id": "f-idem",
          "text": "The gateway probably does not deduplicate retries, so a timeout can lead to a double charge.",
          "source": "inferred"
        }
      ]
    },
